        print("\n MENU ADMIN ")
        print("1. Tambah Lagu")
        print("2. Lihat Semua Lagu")
        print("3. Update Lagu")
        print("4. Hapus Lagu")
        print("0. Kembali")

        pilih = input("Pilih menu: ")

        if pilih == "1":
            id = input("ID: ")
            title = input("Judul: ")
            artist = input("Artis: ")
            genre = input("Genre: ")
            year = input("Tahun: ")
            library.append(DoublyLinkedList.create_song(id, title, artist, genre, year))
            print("✔ Lagu berhasil ditambahkan.")

        elif pilih == "2":
            for song in library.display():
                print(song)

        elif pilih == "3":
            id = input("ID lagu: ")
            title = input("Judul baru: ")
            artist = input("Artis baru: ")
            library.update(id, {"title": title, "artist": artist})
            playlist.update(id, {"title": title, "artist": artist})
            print("✔ Lagu berhasil di-update.")

        elif pilih == "4":
            id = input("ID lagu: ")
            if library.delete(id):
                playlist.delete(id)
                print("✔ Lagu dihapus.")
            else:
                print("ID tidak ditemukan.")

